        "queryParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "YOUR_TICKETMASTER_API_KEY"
            },
            {
              "name": "size",
              "value": "5"
            },
            {
              "name": "countryCode",
              "value": "US"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        -480,
        -48
      ],
      "id": "35bafc7e-ca1e-4ef0-b359-a504b9a1bab3",
      "name": "Ticketmaster API"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nconst events = data._embedded?.events || [];\n\nreturn events.map(event => ({\n  json: {\n    event_id: event.id || null,\n    event_name: event.name || null,\n\n    date: event.dates?.start?.localDate || null,\n    time: event.dates?.start?.localTime || null,\n\n    venue: event._embedded?.venues?.[0]?.name || null,\n    city: event._embedded?.venues?.[0]?.city?.name || null,\n    country: event._embedded?.venues?.[0]?.country?.countryCode || null,\n\n    url: event.url || null,\n\n    status: event.dates?.status?.code || null\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -320,
        -32
      ],
      "id": "9fdce10e-7085-40d8-a592-674ee1c3c39e",
      "name": "Normalize Events"
    },
    {
